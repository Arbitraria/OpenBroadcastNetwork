        health.is_degraded = true;
    }
}

/// Update the TopologyConfig
pub fn update_config(&mut self, config: TopologyConfig) {
    self.config = config;
}

impl Default for ConnectionHealth {
    fn default() -> Self {
        Self {
            quality: 1.0,
            success_rate: 1.0,
            last_success: Instant::now(),
            consecutive_failures: 0,
            history: VecDeque::with_capacity(10), // Keep last 10 measurements
            last_checked: Instant::now(),
            is_degraded: false,
        }
    }
}

impl TopologyManager {
    /// Create a new topology manager
    pub fn new(local_peer_id: PeerId, config: TopologyConfig) -> Self {
        Self {
            local_peer_id,
            config,
            peers: Arc::new(RwLock::new(HashMap::new())),
            trees: Arc::new(RwLock::new(HashMap::new())),
            tasks: Arc::new(RwLock::new(Vec::new())),
            connection_health: Arc::new(RwLock::new(HashMap::new())),
            metrics: None,
        }
    }

    /// Start the topology manager
    pub async fn start(&self) -> Result<(), OverlayError> {
        // Start the rebalance task
        let rebalance_task = tokio::spawn(
            Self::periodic_rebalance(
                self.trees.clone(),
                self.peers.clone(),
                self.config.clone()
            )
        );

        // Start the connection health monitoring task
        let health_task = tokio::spawn(
            Self::monitor_connections(
                self.trees.clone(),
                self.peers.clone(),
                self.connection_health.clone(),
                self.metrics.clone(),
                self.config.clone()
            )
        );

        // Store the task handles
        let mut tasks = self.tasks.write().await;
        tasks.push(rebalance_task);
        tasks.push(health_task);

        Ok(())
    }

    /// Set the metrics instance
    pub fn set_metrics(&mut self, metrics: Arc<crate::overlay::metrics::OverlayMetrics>) {
        self.metrics = Some(metrics);
    }

    /// Monitor connection health and proactively address issues
    async fn monitor_connections(
        trees: Arc<RwLock<HashMap<StreamId, crate::overlay::tree::StreamTree>>>,
        peers: Arc<RwLock<HashMap<PeerId, Peer>>>,
        connection_health: Arc<RwLock<HashMap<PeerId, ConnectionHealth>>>,
        metrics: Option<Arc<crate::overlay::metrics::OverlayMetrics>>,
        config: TopologyConfig
    ) {
        let mut interval = tokio::time::interval(config.health_check_interval);
        
        loop {
            interval.tick().await;
            
            // Get list of active stream IDs
            let stream_ids = {
                let trees = trees.read().await;
                trees.keys().cloned().collect::<Vec<_>>()
            };
            
            for stream_id in &stream_ids {
                // Check for degraded connections in each stream
                let degraded_peers = Self::detect_degraded_connections(
                    &trees, 
                    &connection_health, 
                    stream_id, 
                    config.health_threshold
                ).await;
                
                if !degraded_peers.is_empty() {
                    // Update metrics if available
                    if let Some(metrics_ref) = &metrics {
                        let metrics = metrics_ref.clone();
                        let connection_failures = metrics.connection_failures.clone();
                        let mut failures = connection_failures.write().await;
                        failures.add(degraded_peers.len() as u64);
                    }
                    
                    // Take proactive action for each degraded peer
                    for peer_id in degraded_peers {
                        Self::prepare_alternative_parents(
                            &trees, 
                            &peers,
                            stream_id, 
                            &peer_id
                        ).await;
                    }
                    
                    // Consider rebalancing if we have significant degradation
                    let tree_needs_rebalance = {
                        let health = connection_health.read().await;
                        let trees = trees.read().await;
                        
                        if let Some(tree) = trees.get(stream_id) {
                            let total_nodes = tree.nodes.len();
                            let degraded_count = tree.nodes.keys().filter(|id| {
                                health.get(*id).map_or(false, |h| h.is_degraded)
                            }).count();
                            
                            // If more than the threshold % of nodes are degraded, rebalance
                            degraded_count as f32 / total_nodes as f32 > config.proactive_rebalance_threshold
                        } else {
                            false
                        }
                    };
                    
                    if tree_needs_rebalance {
                        // Perform an immediate rebalance for this stream
                        let mut trees = trees.write().await;
                        if let Some(tree) = trees.get_mut(stream_id) {
                            let _ = tree.rebalance(); // Ignore result
                        }
                    }
                }
            }
            
            // Clean up old health records
            Self::cleanup_health_records(&connection_health, config.peer_cache_lifetime).await;
        }
    }
    
    /// Detect peers with degraded connections
    async fn detect_degraded_connections(
        trees: &Arc<RwLock<HashMap<StreamId, crate::overlay::tree::StreamTree>>>,
        connection_health: &Arc<RwLock<HashMap<PeerId, ConnectionHealth>>>,
        stream_id: &StreamId,
        health_threshold: f32
    ) -> Vec<PeerId> {
        let mut degraded_peers = Vec::new();
        
        let trees_guard = trees.read().await;
        let mut health_guard = connection_health.write().await;
        
        if let Some(tree) = trees_guard.get(stream_id) {
            for (peer_id, node) in &tree.nodes {
                // Check existing health record or create a new one
                let health = health_guard.entry(*peer_id).or_insert_with(ConnectionHealth::default);
                
                // Update degraded status based on metrics
                let is_degraded = node.connection_quality < health_threshold || 
                                  node.failure_count > 2 || 
                                  node.latency > 500;
                
                // Record history point
                if health.history.len() >= 10 {
                    health.history.pop_front();
                }
                health.history.push_back((Instant::now(), node.connection_quality));
                
                // Update health status
                health.quality = node.connection_quality;
                health.is_degraded = is_degraded;
                health.last_checked = Instant::now();
                
                // If degraded, add to the list
                if is_degraded {
                    degraded_peers.push(*peer_id);
                }
            }
        }
        
        degraded_peers
    }
    
    /// Prepare alternative parents for children of a potentially failing node
    async fn prepare_alternative_parents(
        trees: &Arc<RwLock<HashMap<StreamId, crate::overlay::tree::StreamTree>>>,
        peers: &Arc<RwLock<HashMap<PeerId, Peer>>>,
        stream_id: &StreamId,
        at_risk_peer: &PeerId
    ) {
        let trees_guard = trees.read().await;
        
        if let Some(tree) = trees_guard.get(stream_id) {
            // Get children of the at-risk peer
            if let Some(children) = tree.get_children(at_risk_peer) {
                if children.is_empty() {
                    return; // No children to worry about
                }
                
                // Find potential alternative parents
                let candidates: Vec<PeerId> = tree.nodes.iter()
                    .filter(|(id, node)| {
                        **id != *at_risk_peer && // Not the at-risk node
                        node.can_accept_children() && // Has capacity
                        node.connection_quality >= 0.8 && // Good connection
                        !children.contains(*id) // Not one of the children
                    })
                    .map(|(id, _)| *id)
                    .collect();
                    
                // For now we just identify alternatives, but don't make any changes
                // The actual switching happens when/if the node actually fails
                // This information could be used to pre-establish backup connections
                // in a more advanced implementation
            }
        }
    }
    
    /// Clean up old health records
    async fn cleanup_health_records(
        connection_health: &Arc<RwLock<HashMap<PeerId, ConnectionHealth>>>,
        max_age: Duration
    ) {
        let now = Instant::now();
        let mut health = connection_health.write().await;
        
        let expired: Vec<PeerId> = health.iter()
            .filter(|(_, h)| now.duration_since(h.last_checked) > max_age)
            .map(|(id, _)| *id)
            .collect();
            
        for id in expired {
            health.remove(&id);
        }
    }
        }
    }
    
    /// Update peer information
    pub async fn update_peer(&self, peer: Peer) -> Result<(), OverlayError> {
        let mut peers = self.peers.write().await;
        // Convert LocalPeerId to PeerId for map key
        match (&peer.id).try_into() {
            Ok(peer_id) => {
                peers.insert(peer_id, peer);
                Ok(())
            }
            Err(e) => Err(OverlayError::InvalidPeerId(format!("Failed to convert peer ID: {}", e)))
        }
    }
    
    /// Remove a peer
    pub async fn remove_peer(&self, peer_id: &PeerId) -> Result<(), OverlayError> {
        let mut peers = self.peers.write().await;
        peers.remove(peer_id);
        
        // Remove from all trees
        let mut trees = self.trees.write().await;
        for (_, tree) in trees.iter_mut() {
            if tree.nodes.contains_key(peer_id) {
                let _ = tree.remove_peer(peer_id);
            }
        }
        
        Ok(())
    }
    
    /// Get the relay path for a stream from source to target
    pub async fn get_relay_path(
        &self, 
        stream_id: &StreamId, 
        target_id: &PeerId
    ) -> Result<Vec<PeerId>, OverlayError> {
        let trees = self.trees.read().await;
        
        if let Some(tree) = trees.get(stream_id) {
            if let Some(path) = tree.get_path_to_peer(target_id) {
                Ok(path)
            } else {
                Err(OverlayError::TopologyError(
                    format!("Peer not in stream: {}", target_id)
                ))
            }
        } else {
            Err(OverlayError::TopologyError(
                format!("Stream not found: {:?}", stream_id)
            ))
        }
    }
    
    /// Get all peers in a stream
    pub async fn get_stream_peers(&self, stream_id: &StreamId) -> Result<Vec<PeerId>, OverlayError> {
        let trees = self.trees.read().await;
        
        if let Some(tree) = trees.get(stream_id) {
            Ok(tree.nodes.keys().cloned().collect())
        } else {
            Err(OverlayError::TopologyError(
                format!("Stream not found: {:?}", stream_id)
            ))
        }
    }
    
    /// Get the publisher for a stream
    pub async fn get_stream_publisher(&self, stream_id: &StreamId) -> Result<PeerId, OverlayError> {
        let trees = self.trees.read().await;
        
        if let Some(tree) = trees.get(stream_id) {
            Ok(tree.root.clone())
        } else {
            Err(OverlayError::TopologyError(
                format!("Stream not found: {:?}", stream_id)
            ))
        }
    }
    
    /// Rebalance a stream's topology with geo-awareness
    pub async fn rebalance_stream(&self, stream_id: &StreamId) -> Result<(), OverlayError> {
        let mut trees = self.trees.write().await;
        let peers = self.peers.read().await;
        
        if let Some(tree) = trees.get_mut(stream_id) {
            tree.rebalance(&peers, &self.config);
            Ok(())
        } else {
            Err(OverlayError::TopologyError(format!("Stream not found: {:?}", stream_id)))
        }
    }
}