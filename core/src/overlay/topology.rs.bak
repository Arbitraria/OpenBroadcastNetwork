    if health.history.len() > 10 {
        health.history.pop_front();
    }
    
    // Recalculate quality
    health.quality = health.history.iter()
        .map(|(_, q)| q)
        .sum::<f32>() / health.history.len() as f32;
    
    // Mark as degraded if failures exceed threshold
